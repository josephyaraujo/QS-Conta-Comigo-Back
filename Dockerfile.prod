FROM python:3.11-slim-bookworm

ENV PYTHONUNBUFFERED=1

RUN apt-get update && apt-get install -y git && rm -rf /var/lib/apt/lists/*

WORKDIR /api

# Copia e instala dependências
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

# Copia o código-fonte para dentro da imagem
COPY . .

# Configura o usuário não-root
RUN groupadd --gid 1000 vscode && \
    useradd --uid 1000 --gid 1000 --shell /bin/bash --create-home vscode && \
    chown -R vscode:vscode /api

USER vscode

# Inicia a aplicação e roda as migrações
CMD ["bash", "-c", "python manage.py migrate && gunicorn conta_comigo_backend.wsgi:application --bind 0.0.0.0:8000 --workers 3"]
